# ===== Apple 库存监控 SaaS · 环境变量模板 =====
# 复制为 .env 后填入真实值；.env 永不入库
#
# 引号规则（重要）：deploy.sh 用 `set -a; source .env` 加载，
# 值里含空格、< >、"、'、$、`、! 等特殊字符必须加引号，否则报 syntax error。
# - 一般情况用双引号（如 SMTP_FROM="StockMon <noreply@glint.red>"）；
# - 密码/密钥里含 $ 或反引号时用单引号（如 PASSWORD='a$b`c'），双引号会展开 $。
# - 空值留空即可（如 PROXY_POOL=），不要注释掉 key 本体。
# - ⚠️ **禁止**行尾注释（R10-P0-1）：systemd EnvironmentFile 不剥行尾注释，
#   `APP_ENV=prod  # 生产` 会被服务读成 "prod  # 生产"（is_prod 误判，生产跑 dev 语义，
#   表现为 prod 硬门槛失效、HTTPS cookie 丢 Secure 标志）。注释一律写在独立行；
#   deploy.sh 校验阶段发现值含 # 会直接报错退出。
# - ⚠️ CRLF（Windows 行尾）陷阱：bash `source` 不剥 \r，
#   `APP_ENV=prod\r` 同样污染值。.env 保持 LF 行尾
#   （deploy.sh 在 source 前会自动清洗 CRLF 并告警、原地改写）。
#
# ⚠️ 安全警告（R5-D-N8）：`source .env` 会执行命令替换和变量展开。
# .env 里**不要写 `$(...)`、反引号**——deploy.sh 以 root 执行，
# 恶意或手误的命令替换会被直接执行。**禁止** `export KEY=` 前缀行
# （systemd EnvironmentFile 会静默丢弃整行；deploy.sh 校验阶段直接报错退出）。

# --- 基础 ---
# dev | prod（生产必填 prod）
APP_ENV=dev
# openssl rand -hex 32 生成，禁止留默认值
APP_SECRET_KEY=change-me-64hex
APP_VERSION=0.1.0
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# certbot 注册邮箱（生产必填）：首次部署申请 HTTPS 证书用，缺失则 deploy.sh 报错退出
SSL_EMAIL=

# --- 数据库 ---
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/stockmon

# --- Apple 接口 ---
APPLE_PROVIDER_ORDER=pickup-message,fulfillment-messages
APPLE_TIMEOUT_SEC=15
APPLE_MAX_STORES_PER_REQ=10
APPLE_COOLDOWN_BASE_SEC=60

# --- 代理池（可选，逗号分隔 http(s)://user:pass@host:port） ---
PROXY_POOL=

# --- 邮件（SMTP，支持阿里云 DirectMail / SendCloud / 自建） ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="StockMon <noreply@glint.red>"
SMTP_TLS=1

# --- 备份失败告警收件人（运维层键，deploy/backup.sh 用，app 不读） ---
# 留空则依次回退 SSL_EMAIL > SMTP_USER；三者都缺时告警被跳过只记日志
# （prod 下 deploy.sh 已做 SMTP 硬门槛校验，部署上下文里一定拿得到）
BACKUP_ALERT_TO=

# --- 短信（预留接口，二期启用） ---
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SECRET=

# --- 爱发电 ---
AFDIAN_USER_ID=
AFDIAN_TOKEN=
AFDIAN_PLAN_STANDARD=afdian_plan_id_standard
AFDIAN_PLAN_PRO=afdian_plan_id_pro
# 自家爱发电赞助页 URL（前端付费指引跳转用；生产填真实地址）
AFDIAN_PAGE_URL=https://afdian.com

# --- 安全 ---
# 受信代理 IP（逗号分隔）。生产必填（nginx 反代场景）：不填则 XFF 默认不信任，
# _client_ip 会取到 127.0.0.1，登录限流把所有用户算成同一个 IP。
TRUSTED_PROXIES=127.0.0.1
SESSION_EXPIRE_HOURS=168
ADMIN_TOTP_REQUIRED=1
LOGIN_FAIL_LOCK=5
LOGIN_LOCK_MINUTES=15
# 首个管理员账号（首次部署时填，启动后自动创建，之后可清空）
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 监控引擎 ---
# ENGINE_ENABLED：API 进程不跑引擎（默认 false，省略即 false）；
# 独立 stockmon-engine.service 的环境里设为 true（见 deploy/stockmon-engine.service）
ENGINE_ENABLED=false
ENGINE_TICK_SEC=5
ENGINE_POLL_JITTER_SEC=3
# Apple 请求预算（反薅）：单用户/分钟上限按有效档位，trial 最严
MAX_APPLE_REQ_PER_USER_PER_MIN_PRO=30
MAX_APPLE_REQ_PER_USER_PER_MIN_STANDARD=20
MAX_APPLE_REQ_PER_USER_PER_MIN_FREE=10
MAX_APPLE_REQ_PER_USER_PER_MIN_TRIAL=3
# 全局每分钟上限；超限时 trial/free/standard 先降速（跳过），pro 优先
GLOBAL_APPLE_REQ_PER_MIN=120
# 会员档位刷新间隔（秒）
TIER_INTERVAL_TRIAL=300
TIER_INTERVAL_FREE=300
TIER_INTERVAL_STANDARD=30
TIER_INTERVAL_PRO=10
