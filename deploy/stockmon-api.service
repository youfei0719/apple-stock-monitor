[Unit]
Description=StockMon API (FastAPI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stockmon/backend
EnvironmentFile=/opt/stockmon/.env
# D1：API 进程不跑监控引擎（ENGINE_ENABLED=false 为默认值，此处显式声明防误配）。
# 引擎由独立 stockmon-engine.service 进程运行（ENGINE_ENABLED=true），避免双引擎
# 重复轮询、重复通知和配额 double-count。
Environment ENGINE_ENABLED=false
ExecStart=/opt/stockmon/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8101 --workers 1
Restart=always
RestartSec=5
StandardOutput=append:/opt/stockmon/logs/api.out.log
StandardError=append:/opt/stockmon/logs/api.err.log

[Install]
WantedBy=multi-user.target
