[Unit]
Description=StockMon Monitor Engine
After=network.target stockmon-api.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stockmon/backend
EnvironmentFile=/opt/stockmon/.env
# D1：本进程是唯一的引擎运行者（API 进程 ENGINE_ENABLED=false 不启动引擎）。
Environment ENGINE_ENABLED=true
ExecStart=/opt/stockmon/backend/.venv/bin/python -m app.services.engine
Restart=always
RestartSec=10
StandardOutput=append:/opt/stockmon/logs/engine.out.log
StandardError=append:/opt/stockmon/logs/engine.err.log

[Install]
WantedBy=multi-user.target
